{
  "name": "zonenow",
  "private": true,
  "description": "ゾーンNOW（PWAプロトタイプ）",
  "scripts": {
    "test": "node tests/full.test.js && node tests/ai.test.js && node tests/features.test.js && node tests/cloud.test.js && node tests/native.test.js && node tests/layout.test.js",
    "test:db": "node tests/db.test.js",
    "vendor": "cp node_modules/@supabase/supabase-js/dist/umd/supabase.js vendor/supabase.js",
    "check:live": "NODE_USE_ENV_PROXY=1 node --no-warnings tests/live.check.js",
    "build:web": "node scripts/build-web.js",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:assets": "node scripts/make-ios-assets.js"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@supabase/supabase-js": "2.117.2",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2"
  }
}
